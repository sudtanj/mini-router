# Copy to .env and fill in what you have. Everything is optional except at
# least one provider key.
#
#   cp .env.example .env
#   docker compose up -d

# --- Provider keys -----------------------------------------------------------
# A key on its own registers that provider. Delete the ones you do not use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Also recognised without any further configuration:
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=

# --- Your own key ------------------------------------------------------------
# What your clients present to mini-router. Comma-separated for more than one.
# Generate something long:  openssl rand -hex 32
MINI_ROUTER_API_KEYS=
