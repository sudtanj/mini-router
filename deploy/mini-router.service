# /etc/systemd/system/mini-router.service
#
#   sudo install -m755 mini-router /usr/local/bin/
#   sudo install -m644 deploy/mini-router.service /etc/systemd/system/
#   sudo install -m600 -D /dev/null /etc/mini-router/env
#   sudo $EDITOR /etc/mini-router/env
#   sudo systemctl enable --now mini-router

[Unit]
Description=mini-router: LLM API aggregator and load balancer
Documentation=https://github.com/sudtanj/mini-router
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/mini-router
ExecReload=/bin/kill -HUP $MAINPID

# The whole configuration lives here; there is no config file to manage.
# One KEY=value per line, mode 600 since it holds your provider keys:
#
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...
#   MINI_ROUTER_POOL_FAST=openai:gpt-4o-mini,anthropic:claude-haiku-4-5
#   MINI_ROUTER_REQUIRE_AUTH=true
#   MINI_ROUTER_API_KEYS=sk-your-own-key
#
# `mini-router --help` lists every variable. There is no configuration file:
# this is the whole of it.
EnvironmentFile=/etc/mini-router/env

Restart=on-failure
RestartSec=5s

# The router drains in-flight streams on SIGTERM. Give a long generation time
# to finish before the kill.
KillSignal=SIGTERM
TimeoutStopSec=90

# A dedicated, transient, unprivileged user. Nothing to create by hand.
DynamicUser=yes

# Ten times more memory than it has ever needed under load. On a board where
# the model server is the thing that must not be killed, this is a fuse.
MemoryMax=64M
MemoryHigh=48M
TasksMax=64

# Keep the proxy off the model server's cores when they are contended.
Nice=5

# Sandbox. mini-router reads one config file, holds provider API keys, and
# talks to the network. Nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/mini-router
CapabilityBoundingSet=
AmbientCapabilities=

# Uncomment to listen on a privileged port such as 80:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
